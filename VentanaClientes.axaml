<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PruebadeAvalanoia.VentanaClientes"
        Title="Clientes Registrados" Width="400" Height="300">
    <StackPanel Margin="20">
        <TextBlock Text="Lista de Clientes Registrados" FontWeight="Bold" Margin="0,0,0,10"/>
        <DataGrid x:Name="GridSecundario" AutoGenerateColumns="True" IsReadOnly="True" Height="200"/>
    </StackPanel>
</Window>